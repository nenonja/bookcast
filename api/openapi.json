  "components": {
    "schemas": {
      "ImportChapter": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "bookId": {
            "type": "string",
            "format": "uuid"
          },
          "bookTitle": {
            "type": "string",
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200000
          },
          "sourceLanguage": {
            "type": "string",
            "default": "en"
          }
        },
        "required": [
          "title",
          "text"
        ]
      },
      "SourceBlock": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "order": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "excludedReason": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "order",
          "text"
        ]
      },
      "Chapter": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "bookId": {
            "type": "string",
            "format": "uuid"
          },
          "bookTitle": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "sourceRevisionId": {
            "type": "string",
            "format": "uuid"
          },
          "sourceLanguage": {
            "type": "string"
          },
          "sourceHash": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceBlock"
            }
          }
        },
        "required": [
          "id",
          "bookId",
          "bookTitle",
          "title",
          "sourceRevisionId",
          "sourceLanguage",
          "sourceHash",
          "createdAt",
          "blocks"
        ]
      },
      "StartGeneration": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "sourceRevisionId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "requestId",
          "sourceRevisionId"
        ]
      },
      "DialogueTurn": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "speakerRole": {
            "type": "string",
            "enum": [
              "HOST",
              "EXPERT"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "speakerRole",
          "text"
        ]
      },
      "ScriptSegment": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "order": {
            "type": "integer"
          },
          "coveredSourceBlockIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "dialogueTurns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DialogueTurn"
            }
          }
        },
        "required": [
          "order",
          "coveredSourceBlockIds",
          "dialogueTurns"
        ]
      },
      "Attempt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "capability": {
            "type": "string"
          },
          "unitKey": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "elapsedMs": {
            "type": "integer",
            "format": "int64"
          },
          "usage": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "format": "int64"
            }
          },
          "estimatedCost": {
            "type": "number",
            "format": "double"
          },
          "retryable": {
            "type": "boolean"
          },
          "errorCode": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "capability",
          "unitKey",
          "provider",
          "model",
          "outcome",
          "elapsedMs",
          "usage",
          "retryable"
        ]
      },
      "Generation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "chapterId": {
            "type": "string",
            "format": "uuid"
          },
          "sourceRevisionId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed"
            ]
          },
          "stage": {
            "type": "string"
          },
          "completedSegments": {
            "type": "integer"
          },
          "totalSegments": {
            "type": "integer"
          },
          "completedAudioGroups": {
            "type": "integer"
          },
          "totalAudioGroups": {
            "type": "integer"
          },
          "generationModel": {
            "type": "string"
          },
          "audioModel": {
            "type": "string"
          },
          "estimatedGenerationCost": {
            "type": "number",
            "format": "double"
          },
          "estimatedAudioCost": {
            "type": "number",
            "format": "double"
          },
          "totalEstimatedCost": {
            "type": "number",
            "format": "double"
          },
          "costComplete": {
            "type": "boolean"
          },
          "errorCode": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "audioUrl": {
            "type": "string"
          },
          "scriptSegments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScriptSegment"
            }
          },
          "attempts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attempt"
            }
          },
          "audioDownloadUrl": {
            "type": "string",
            "description": "Download URL for the completed final M4A"
          }
        },
        "required": [
          "id",
          "chapterId",
          "sourceRevisionId",
          "status",
          "stage",
          "completedSegments",
          "totalSegments",
          "completedAudioGroups",
          "totalAudioGroups",
          "generationModel",
          "audioModel",
          "estimatedGenerationCost",
          "estimatedAudioCost",
          "totalEstimatedCost",
          "costComplete",
          "retryable",
          "scriptSegments",
          "attempts"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    }
  }
}
